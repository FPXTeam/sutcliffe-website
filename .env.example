# Required by the website contact form on Vercel
RESEND_API_KEY=
CONTACT_EMAIL=sales@sutcliffetrading.com
CONTACT_FROM=website@sutcliffetrading.com

# Google Analytics 4 Measurement ID, for example G-XXXXXXXXXX
# GA4 loads only after the visitor allows analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Only required if Google Search Console uses HTML tag verification.
# Not required when the Search Console Domain property is verified through DNS.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
